HELIUS_API_KEY=your_helius_api_key_here
# QuickNode is the primary transaction/balance RPC. Keep Helius as failover.
QUICKNODE_RPC_URL=
PRIMARY_RPC_URL=
HELIUS_RPC_URL=
BACKUP_RPC_URL=
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=
TRADING_WALLET_PRIVATE_KEY=
TWITTER_BEARER_TOKEN=
GROK_API_KEY=
DEEPSEEK_API_KEY=
JUPITER_API_KEY=
# MT-560: Strategy B scan cadence in seconds (default 1 since MT-588).
# Jupiter tokens/v2 Developer tier (10 RPS) supports three discovery
# endpoints per cycle at 1s (~3 req/s). The cycle sleep skips when screening
# takes longer than the interval, so there is no queue-up under slow networks.
STRATEGY_B_SCAN_INTERVAL=1
WALLET_PRIVATE_KEY=base64_encoded_solana_keypair_bytes
MAX_POSITION_SOL=
MAX_PORTFOLIO_SOL=
MAX_SLIPPAGE_BPS=
EXECUTION_MODE=paper
PRIORITY_FEE_LAMPORTS=10000
# MT-589: Jito bundle routing lives in src/chain/jupiter_swap.py as the
# module-level USE_JITO_BUNDLES constant (default True) — not an env var.
# Every swap is wrapped in a bundle with a >= 0.001 SOL tip to a canonical
# Jito tip account; bundle failures fall back to the plain RPC send.
JITO_TIP_LAMPORTS=0
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PHRASE=
LIVE_KILL_SWITCH=true
MAX_LIVE_TRADE_SOL=0.01
MAX_LIVE_DAILY_TRADES=3
MAX_LIVE_DAILY_LOSS_SOL=0.05
MIN_LIVE_WALLET_BALANCE_SOL=0.05
IMESSAGE_RECIPIENT=+1XXXXXXXXXX  # your iPhone number or Apple ID email for trade alerts
