HELIUS_API_KEY=your_helius_api_key_here
# QuickNode is the primary RPC and hosts the Metis Swap API + Lil' JIT add-ons.
# Keep Helius as failover.
QUICKNODE_RPC_URL=
PRIMARY_RPC_URL=
HELIUS_RPC_URL=
BACKUP_RPC_URL=
BIRDEYE_API_KEY=
DEXSCREENER_API_KEY=
TRADING_WALLET_PRIVATE_KEY=
TWITTER_BEARER_TOKEN=
GROK_API_KEY=
DEEPSEEK_API_KEY=
JUPITER_API_KEY=
# V2 Hive state. Set this to a dedicated Hive login with memecoin_writer access.
# The runtime refuses to start without it and never falls back to SQLite.
MEMECOIN_POSTGRES_DSN=
# DATABASE_URL is accepted for external operator tools such as the V2 kill switch.
DATABASE_URL=
MEMECOIN_COLLECT_INTERVAL_SECONDS=1
MEMECOIN_EXECUTOR_CYCLE_SECONDS=1
MEMECOIN_RECONCILIATION_INTERVAL_SECONDS=300
# MT-560: Strategy B scan cadence in seconds (default 1 since MT-588).
# Jupiter tokens/v2 Developer tier (10 RPS) supports three discovery
# endpoints per cycle at 1s (~3 req/s). The cycle sleep skips when screening
# takes longer than the interval, so there is no queue-up under slow networks.
STRATEGY_B_SCAN_INTERVAL=1
WALLET_PRIVATE_KEY=base64_encoded_solana_keypair_bytes
MAX_POSITION_SOL=
MAX_PORTFOLIO_SOL=
MAX_SLIPPAGE_BPS=
EXECUTION_MODE=paper
# Strategy B runtime position and capacity limits. These apply in paper and live modes.
POSITION_SIZE_SOL=0.02
MAX_OPEN=5
# The live breaker never clears itself. Use scripts/reset_breaker.py with an
# explicit MANUAL_RESET confirmation only after investigating the incident.
PRIORITY_FEE_LAMPORTS=10000
# Jito is used only for swaps at or above this SOL notional. Smaller swaps use
# direct RPC, while eligible swaps use QuickNode Lil' JIT's dynamic tip floor.
JITO_MIN_SIZE_SOL=0.1
JITO_TIP_LAMPORTS=0
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION_PHRASE=I_UNDERSTAND_THIS_CAN_LOSE_REAL_SOL
LIVE_KILL_SWITCH=false
MAX_LIVE_TRADE_SOL=0.02
MAX_LIVE_DAILY_TRADES=3
MAX_LIVE_DAILY_LOSS_SOL=0.05
MIN_LIVE_WALLET_BALANCE_SOL=0.05
# Optional runtime alerts. Keep credentials only in the untracked .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
IMESSAGE_RECIPIENT=+1XXXXXXXXXX  # your iPhone number or Apple ID email for trade alerts
